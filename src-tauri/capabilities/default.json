{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Enregistrer et rouvrir un fichier de concours choisi par l'utilisateur, et ouvrir la fenêtre d'affichage public.",
  "windows": [
    "main",
    "affichage"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:default",
    "core:webview:allow-create-webview-window"
  ]
}
